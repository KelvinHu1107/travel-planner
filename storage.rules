rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 只有此 trip 的 members 才能讀寫該 trip 的檔案（Bug #3）
    match /trips/{tripId}/{allPaths=**} {
      allow read: if request.auth != null
        && (
          request.auth.uid in firestore.get(
            /databases/(default)/documents/trips/$(tripId)
          ).data.members
        );
      allow write: if request.auth != null
        && request.resource.size < 50 * 1024 * 1024
        && (
          request.auth.uid in firestore.get(
            /databases/(default)/documents/trips/$(tripId)
          ).data.members
        );
      // Bug #5：delete 必須明確授權，否則 deleteObject 會被拒
      allow delete: if request.auth != null
        && (
          request.auth.uid in firestore.get(
            /databases/(default)/documents/trips/$(tripId)
          ).data.members
        );
    }
  }
}
