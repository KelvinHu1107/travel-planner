rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin has full access to everything
    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isAdmin == true;
    }

    // Admin collection: only the admin themselves can read their own doc
    match /admins/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // User profiles
    match /users/{uid} {
      allow read, write: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }

    // Trips
    // Bug #1: 讀取 → 只有 members 可以讀（避免任何登入使用者靠 tripId 掃描資料）
    // Bug #2: 更新 → 允許 members 更新，但非 owner 不可修改 ownerId
    // Bug #4: joinTrip → 允許使用者將自己 uid 加入 members（arrayUnion 樣式）
    match /trips/{tripId} {
      allow read: if request.auth != null &&
        (isAdmin() || request.auth.uid in resource.data.members);
      // Bug #39：maxLength 由 rules 強制
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.members
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100;
      allow update: if request.auth != null && (
        isAdmin()
        // 已是成員：可修改，但若非 owner，不可修改 ownerId；且 name 長度不可超過 100
        || (
          request.auth.uid in resource.data.members
          && (request.auth.uid == resource.data.ownerId
              || request.resource.data.ownerId == resource.data.ownerId)
          && (!('name' in request.resource.data) || request.resource.data.name.size() <= 100)
        )
        // 新加入：僅可將自己 uid 加進 members，不可修改 ownerId、其他 members 不變
        || (
          !(request.auth.uid in resource.data.members)
          && request.resource.data.members == resource.data.members.concat([request.auth.uid])
          && request.resource.data.ownerId == resource.data.ownerId
        )
      );
      allow delete: if request.auth != null &&
        (isAdmin() || request.auth.uid == resource.data.ownerId);

      match /cards/{cardId} {
        allow read, write: if request.auth != null &&
          (request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.members || isAdmin());
      }

      match /todos/{todoId} {
        allow read, write: if request.auth != null &&
          (request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.members || isAdmin());
      }

      match /packing/{itemId} {
        allow read, write: if request.auth != null &&
          (request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.members || isAdmin());
      }

      match /expenses/{expenseId} {
        allow read, write: if request.auth != null &&
          (request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.members || isAdmin());
      }
    }

    // Notifications: 每個使用者只能操作自己的通知
    match /notifications/{notificationId} {
      allow read: if request.auth != null &&
        (isAdmin() || request.auth.uid == resource.data.userId);
      // Bug #1：建立通知必須符合下列條件（防止 spam）
      // - actorUid 必須是目前登入者
      // - createdAt 為 server timestamp（request.time）
      // - expiresAt 最多 7 天後
      // - read 必須為 false
      allow create: if request.auth != null
        && request.resource.data.userId is string
        && request.resource.data.userId.size() > 0
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt <= request.time + duration.value(7 * 24 * 60 * 60, 's')
        && request.resource.data.read == false;
      // Bug #36：更新僅允許將 read 從 false 改為 true，其他欄位不可動
      allow update: if request.auth != null && (
        isAdmin()
        || (
          request.auth.uid == resource.data.userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read == true
        )
      );
      // Bug #3：刪除允許通知擁有者，或觸發者（actor）自行清理
      allow delete: if request.auth != null && (
        isAdmin()
        || request.auth.uid == resource.data.userId
        || request.auth.uid == resource.data.actorUid
      );
    }

    // Feedback
    match /feedback/{feedbackId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isAdmin();
    }
  }
}
